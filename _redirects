# 사이트 루트 → 메인
/    /main.html    301

# Cloudflare Pages 는 디렉터리 인덱스로 index.html 만 인식한다.
# navinam/ 와 navinam/m/ 는 index.htm 만 있어서 fallback 으로 빠지므로 명시 rewrite.
# (status 200 = rewrite. URL 은 그대로, 내용만 해당 파일에서)
/navinam/      /navinam/index.htm      200
/navinam/m/    /navinam/m/index.htm    200

# --- 짧은 URL alias (navinam/ prefix 제거) ---
# 디스크 폴더는 navinam/ 안에 그대로 두고 URL 만 새로 노출.
# splat(:splat) 으로 하위 자원도 함께 매핑 → 페이지 내 상대 경로 안 깨짐.
/town/*                     /navinam/town/:splat                       200
/mokdong/*                  /navinam/mokdong/:splat                    200
/yangcheon-archivist/*      /navinam/yangcheon-archivist/:splat        200
# yangcheon_museum: 다른 폴더와 동일하게 splat 매핑.
# (이전엔 html/ 하위에 페이지가 있어 분리 매핑이었으나 폴더 평탄화로 단순화)
/yangcheon_museum/*          /navinam/yangcheon_museum/:splat            200
/mokdong-history/*           /navinam/mokdong-history/:splat             200
/mokdong-now/*               /navinam/mokdong-now/:splat                 200
# 옛 navinam/ 경로로 들어와도 새 짧은 URL 로 정리해서 보여줌
/navinam/town/*                  /town/:splat                  301
/navinam/mokdong/*               /mokdong/:splat               301
/navinam/yangcheon-archivist/*   /yangcheon-archivist/:splat   301
/navinam/yangcheon_museum/*      /yangcheon_museum/:splat      301

# Deep path 의 main.html 은 그 콘텐츠 메인으로 (Cloudflare 404 fallback 루프 방지)
/navinam/main.html                        /navinam/                        301
/ycpark/main.html                         /ycpark/                         301
/yclibrary/main.html                      /yclibrary/                      301
/sinwol07/main.html                       /sinwol07/                       301
/town/main.html                           /town/                           301
/mokdong/main.html                        /mokdong/                        301
/yangcheon-archivist/main.html            /yangcheon-archivist/            301
/yangcheon_museum/main.html               /yangcheon_museum/               301
/mokdong-history/main.html                /mokdong-history/                301
/mokdong-now/main.html                    /mokdong-now/                    301
